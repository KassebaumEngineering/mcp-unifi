# Copy to .env in this directory. .env is gitignored.
# Do not put API keys, console passwords, or bearer tokens in this file.
# Those belong in secrets/. See secrets/README.
#
# MCP_UNIFI_READONLY is not read from here. It is hardcoded in the compose
# files. Editing this file cannot turn writes back on.

# IPv4 address of the machine that runs the container. Required.
#   tailscale ip -4
# The HTTP compose file refuses to start if this is unset. There is no default.
# Use an address that is assigned on this machine. Do not use another host's
# address, and do not use an all-interfaces bind.
BIND_ADDR=100.64.0.1

MCP_PORT=3714

# Real gateway. true does not skip api_key_file or pinned_cert checks when
# controllers.yaml names those paths.
STUB_MODE=false

# Must match a `name:` in controllers.yaml when more than one gateway is listed.
MCP_UNIFI_DEFAULT_CONTROLLER=home

# network, or network,protect,access. Access needs access_api_key_file in the
# controllers file and a separate secret mount; this stack does not add one.
MCP_UNIFI_MODULES_ENABLED=network

# Client name written into the audit log for the bearer token file.
MCP_UNIFI_CLIENT_ID=audit

LOG_LEVEL=INFO
LOG_FORMAT=json
TZ=UTC

# Published image. Uncomment to run a locally built image instead.
# A local build from this repo seeds the audit volume as uid 1000.
# The 0.27.0 tag does not; see README.md "Audit log".
# MCP_UNIFI_IMAGE=mcp-unifi:local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
build/
dist/
.eggs/

# Test / coverage artefacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Virtual envs
.venv/
.venv-*/
venv/
env/

# IDE / OS
.vscode/
.idea/
.DS_Store
*.swp

# Local secrets and overrides
.env
.env.*
!.env.example
docker-compose.override.yml

# Standalone compose deployment: real config and secret files stay local.
# The example, the secrets README, and pins/.gitkeep stay tracked.
deploy/compose/controllers.yaml
deploy/compose/secrets/*
!deploy/compose/secrets/README
deploy/compose/pins/*
!deploy/compose/pins/.gitkeep

# Internal Forge agent build notes (not for public consumption)
SESSION-RESUME.md

# Scratch artefacts (e.g. tool-schema snapshots from scripts/dump_tool_schemas.py)
scripts/*.json

# Audit log default sink (when running locally / from tests)
audit.jsonl

# uv side-effect lockfile — project uses requirements*.lock as source of truth
uv.lock

# Claude Code agent worktrees and local session state (never part of the repo).
.claude/
